{
  "name": "autosenseai",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react": "^4.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.8.1",
    "turbo": "^2.8.10"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx,js,jsx,json}": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/api/**/*.{ts,tsx,js,jsx,json}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/**/*.{ts,tsx,js,jsx,json}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ]
  }
}
