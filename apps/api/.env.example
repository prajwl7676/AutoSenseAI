# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/autosense

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Keycloak ──────────────────────────────────────────────────
# JWKS endpoint Keycloak exposes (used to verify JWT signatures)
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/autosense/protocol/openid-connect/certs

# Token issuer — must match the `iss` claim inside the JWT
KEYCLOAK_ISSUER=http://localhost:8080/realms/autosense

# ── Server ────────────────────────────────────────────────────
PORT=3001
